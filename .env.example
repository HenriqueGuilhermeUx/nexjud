# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# APIs Externas
VITE_INFOSIMPLES_TOKEN=your-infosimples-token
VITE_CNP_API_CREDENTIAL=your-cnp-api-credential
VITE_ZAPSIGN_API_TOKEN=your-zapsign-api-token
VITE_CNJ_API_KEY=your-cnj-api-key
VITE_ESCAVADOR_API_KEY=your-escavador-api-key

# NexOffice integration
# Client launcher gate. Keep false in production until controlled validation is complete.
VITE_NEXOFFICE_ENABLED=false
# Client trigger for aggregate-only legal operational signals.
VITE_NEXOFFICE_LEGAL_SIGNALS_ENABLED=false

# Server-side gates. Never prefix secrets with VITE_.
# Normal target after validation: https://api.nexoffices.com.br
# Controlled staging target: https://nexoffice-staging-api.onrender.com
NEXOFFICE_BASE_URL=https://nexoffice-staging-api.onrender.com
NEXOFFICE_INTERNAL_KEY=
NEXOFFICE_INTEGRATION_ENABLED=false
NEXOFFICE_LEGAL_SIGNALS_ENABLED=false
# Must remain false throughout staging. It records the local policy gate and must agree with NexOffice staging health.
NEXOFFICE_EXTERNAL_EFFECTS_ENABLED=false
