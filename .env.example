# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# APIs Externas
VITE_INFOSIMPLES_TOKEN=your-infosimples-token
VITE_CNP_API_CREDENTIAL=your-cnp-api-credential
VITE_ZAPSIGN_API_TOKEN=your-zapsign-api-token
VITE_CNJ_API_KEY=your-cnj-api-key
VITE_ESCAVADOR_API_KEY=your-escavador-api-key

# NexOffice add-on
# Public launcher flag. Keep false until the NexOffice runtime is deployed and configured.
VITE_NEXOFFICE_ENABLED=false
# Public sync trigger flag. Requires the server-side flag below too.
VITE_NEXOFFICE_LEGAL_SIGNALS_ENABLED=false
# Server-side Netlify Function settings. Never prefix the internal key with VITE_.
NEXOFFICE_BASE_URL=
NEXOFFICE_INTERNAL_KEY=
# Server-side gate. Sends only aggregate operational counts (never process/client/legal text) when true.
NEXOFFICE_LEGAL_SIGNALS_ENABLED=false

# NexJud Mini for NexOffice. Server-to-server only, disabled by default.
# Prefer a dedicated key. NEXOFFICE_INTERNAL_KEY remains a backward-compatible fallback.
NEXOFFICE_MINI_ENABLED=false
NEXOFFICE_MINI_KEY=
# OPENAI_API_KEY is already used by NexJud AI functions and remains server-side only.
OPENAI_API_KEY=
# Optional override; defaults to gpt-4.1-mini.
NEXJUD_MINI_MODEL=
