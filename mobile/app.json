{
  "expo": {
    "name": "NexJud Companion",
    "slug": "nexjud-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nexjud",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090f",
    "primaryColor": "#6366f1",
    "android": {
      "package": "com.nexjud.companion",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.nexjud.companion",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "O NexJud usa a câmera para digitalizar documentos jurídicos.",
        "NSMicrophoneUsageDescription": "O NexJud usa o microfone para registrar reuniões e perguntas por voz.",
        "NSPhotoLibraryUsageDescription": "O NexJud acessa seus arquivos para importar documentos jurídicos."
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-document-picker",
      "expo-image-picker",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e9520c52-0fa7-4d00-ae07-aea3f17946c4"
      }
    }
  }
}
